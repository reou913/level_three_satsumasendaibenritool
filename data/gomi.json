 "rules": [
  {
   "region": "本土",
   "label": "燃やせるごみ",
   "text": "指定袋（透明）に入れ、収集日当日の朝8時までに、決められた収集所へ。生ごみは水気をよく切り、袋の口をしっかりしばる。廃油は固めるか、古布などに吸わせる。",
   "source_url": "https://www.city.satsumasendai.lg.jp/kurashi_tetsuzuki/gomi_recycle/1/1/5652.html",
   "checked": "2026-11-12"
  },
  {
   "region": "本土",
   "label": "収集されないもの",
   "text": "燃やせないごみや不適物がまざった袋、中身が見えない袋、指定外の袋は収集されません。",
   "source_url": "https://www.city.satsumasendai.lg.jp/kurashi_tetsuzuki/gomi_recycle/1/1/5652.html",
   "checked": "2026-11-12"
  },
  {
   "region": "本土",
   "label": "収集所の場所",
   "text": "収集所の場所は、自治会長などに確認してください。",
   "source_url": "https://www.city.satsumasendai.lg.jp/kurashi_tetsuzuki/gomi_recycle/1/1/5652.html",
   "checked": "2026-11-12"
  },
